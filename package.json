{
  "name": "react-experiment-repo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:scan": "npx react-scan@latest localhost:3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format:check": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "lint:check": "biome lint ./src",
    "lint:fix": "biome lint ./src --fix",
    "type:performance": "tsc --generateTrace trace-output --incremental false",
    "type:check": "tsc --noEmit",
    "spell:check": "cspell . --gitignore --config cspell.config.json",
    "test": "vitest --coverage",
    "test:check": "vitest run",
    "check:all": "bun run format:check && bun run lint:check && bun run type:check && bun run spell:check && bun run test:check",
    "fix:all": "bun run format:fix && bun run lint:fix",
    "theme": "yamada-cli tokens ./src/theme/index.ts",
    "theme:watch": "yamada-cli tokens ./src/theme/index.ts --watch",
    "prepare": "bun theme",
    "depcheck": "bunx knip"
  },
  "dependencies": {
    "@conform-to/react": "^1.7.2",
    "@conform-to/valibot": "^1.7.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@next/third-parties": "^16.0.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@valibot/i18n": "^1.0.0",
    "@vercel/analytics": "^2.0.0",
    "@yamada-ui/react": "^2.2.10",
    "jotai": "^3.0.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "nodemailer": "^10.0.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remeda": "^2.23.0",
    "server-only": "^0.0.1",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.4",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@yamada-ui/cli": "^2.1.15",
    "cspell": "^10.0.0",
    "playwright": "^1.53.1",
    "typescript": "^7.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
